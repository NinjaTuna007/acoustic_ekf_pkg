<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acoustic_ekf_pkg</name>
  <version>0.0.1</version>
  <description>ROS 2 package for real-time vehicle localization based on acoustic pings using EKF</description>
  <maintainer email="sdup@kth.se">Shekhar Devm Upadhyay</maintainer>
  <license>MIT</license>
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>python3-utm</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
