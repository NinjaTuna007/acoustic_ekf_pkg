<?xml version="1.0"?>
<launch>
    <arg name="setpoint_modem_ids" default=""
         description="Two modem ids for the setpoint diameter, e.g. 067,069. Empty uses the two fastest."/>
    <arg name="use_sim_time" default="false"
         description="false on the vehicle; true only for bag replay"/>
    <node pkg="acoustic_ekf_pkg"
          exec="ukf_node"
          name="acoustic_ukf_node"
          output="screen">
        <param name="config_file" value="ukf_config.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="setpoint_modem_ids" value="$(var setpoint_modem_ids)"/>
        <!-- Add more parameters as needed -->
        <!-- Published topics (see config/ukf_config.yaml):
               /follower/ukf/state     (std_msgs/Float32MultiArray)
               /follower/ukf/navsatfix (sensor_msgs/NavSatFix)  [_<modem_id>/_centroid]
               /follower/ukf/pose      (geometry_msgs/PoseWithCovarianceStamped)
               /follower/ukf/setpoint  (geographic_msgs/GeoPoint)  desired follower position
               /follower/ukf/delta_pos (std_msgs/Float32) -->
        <!-- Example remap: -->
        <!-- <remap from="/follower/ukf/setpoint" to="/custom/setpoint"/> -->
    </node>
</launch>
